<?xml version="1.0" encoding="utf-8"?>
<!-- The More page: extra apps (config.xml, more_apps) and Developer options, as a grid of tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingEnd="56dp"
    android:paddingTop="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/more"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp"
        android:fontFamily="@font/open_sans"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02" />

    <!-- Must not clip so focused (scaled) tiles can overflow their cells. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/moreGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
