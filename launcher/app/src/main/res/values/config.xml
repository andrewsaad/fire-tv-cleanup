<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- The one row of tiles, in this order (at most "columns"). Missing apps are skipped. No other apps are shown.
         One list for every TV: Fire TV and Google TV package names side by side. -->
    <string-array name="dock_apps">
        <item>com.amazon.firetv.youtube</item>     <!-- YouTube, Fire TV -->
        <item>com.google.android.youtube.tv</item> <!-- YouTube, Google TV -->
        <item>com.plexapp.android</item>
        <item>com.nst.iptvsmarterstvbox</item>
        <item>com.genraltv.app</item>
        <item>com.ottplay.ottplay</item>           <!-- Televizo (IPTV) -->
        <item>net.mbc.shahidTV</item>              <!-- MBC Shahid -->
    </string-array>

    <!-- The More page (the last tile in the row), in this order. Missing apps are skipped; Developer options is
         always added at the end. Several names per app cover different TVs and alternatives. -->
    <string-array name="more_apps">
        <item>com.rma.speedtesttv</item>           <!-- Internet Speed Test (main Google TV) -->
        <item>org.zwanoo.android.speedtest</item>  <!-- Speedtest by Ookla -->
        <item>com.ookla.speedtest.tv</item>         <!-- Speedtest, TV build -->
        <item>com.analiti.fastest.android</item>   <!-- Analiti speed test -->
        <item>org.xbmc.kodi</item>                 <!-- Kodi -->
        <item>com.lonelycatgames.Xplore</item>     <!-- X-plore file manager -->
        <item>com.alphainventor.filemanager</item> <!-- File Commander -->
        <item>com.estrongs.android.pop</item>      <!-- ES File Explorer -->
        <item>com.android.documentsui</item>       <!-- Android Files -->
        <item>com.esaba.downloader</item>          <!-- Downloader -->
        <item>com.iptvapp</item>                   <!-- iptv_app -->
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.amazon.tv.livetv</item>
        <item>com.mediatek.opapp</item>      <!-- 16 European satellite-provider shortcuts -->
        <item>com.amazon.smarthomemapviewapp</item>  <!-- Alexa Smart Home -->
        <item>com.amazon.spiderpork</item>   <!-- Luna -->
        <item>com.amazon.bueller.music</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.amazon.tv.livetv</string>

    <!-- Tiles across the screen: the most apps the row can hold. -->
    <integer name="columns">4</integer>
</resources>
